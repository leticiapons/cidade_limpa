# Copie este arquivo para ".env" e preencha. NUNCA publique o .env no GitHub.
PORT=3000
NODE_ENV=development
# Endereço do PostgreSQL (Neon, Supabase, Render, local...)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
# Use "true" se o provedor exigir SSL e a URL acima nao tiver sslmode=require
DATABASE_SSL=false
# Chave secreta do login: texto aleatorio com 32+ caracteres
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-texto-aleatorio-longo
